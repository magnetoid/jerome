# Copy to .env. Placeholders and defaults only: never put real secrets in this file.

# JEROME_DATABASE_URL=postgresql+psycopg://jerome:jerome@localhost:5433/jerome
# JEROME_DATA_DIR=~/.local/share/jerome
# JEROME_LANGUAGETOOL_URL=http://localhost:8010
# JEROME_MODELS={"ai": {"provider": "anthropic", "model": "claude-opus-5-5", "effort": "high"}}
# JEROME_PRICES={}
# JEROME_WEBHOOK_SECRET=
# JEROME_TEXT_DAILY_COST_CAP=5
# JEROME_TEXT_RPM=30
# JEROME_MAX_UPLOAD_MB=50
# Encrypts the secrets saved on the Settings page. Make one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JEROME_SECRET_KEY=
# Behind a reverse proxy: the address it connects from, as a JSON list (enables per-IP login throttling).
# JEROME_TRUSTED_PROXIES=["172.17.0.1"]
# Plain-http local development only: lets the browser keep the login cookie without https.
# JEROME_COOKIE_SECURE=false

# The Anthropic API key (no JEROME_ prefix). Read from here or from the environment.
ANTHROPIC_API_KEY=

# Docker stack only: the Postgres password. Defaults to "jerome", which is fine on a laptop.
# On a server set a long random one of letters and digits (e.g. `openssl rand -hex 24`)
# BEFORE the first `docker compose up`: Postgres applies it only when its volume is created.
# POSTGRES_PASSWORD=
